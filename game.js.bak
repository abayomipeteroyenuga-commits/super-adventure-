
const c=document.getElementById('game'),ctx=c.getContext('2d');
if(!c||!ctx) throw new Error('Game canvas could not be initialized.');
let viewW=1100,viewH=innerHeight;
let running=false,last=0,cam=0,score=0,coins=0,stars=0,lives=3,world=0,level=1,timeLeft=180;
let finishCelebration=0, finishNextWorld=false, finishEmote='🥳', gameState='menu';
let rescueSequence=0, rescueDone=false;
let player,platforms=[],enemies=[],items=[],projectiles=[],particles=[],goal,boss,shopOpen=false,paused=false,checkpointX=70,checkpointY=350,rafId=0,camY=0;
const keys={}, WORLD_COUNT=20;
let audioCtx=null, musicGain=null, sfxGain=null, musicTimer=null, musicOn=true;
const musicTracks=[
 {mel:[262,330,392,523,659,523,392,330],bass:[131,165,196,165],beat:190},
 {mel:[220,247,294,330,440,392,330,294],bass:[110,123,147,165],beat:175},
 {mel:[294,349,440,523,587,523,440,349],bass:[147,175,220,196],beat:165},
 {mel:[196,247,294,370,494,370,294,247],bass:[98,123,147,185],beat:155},
 {mel:[330,392,494,659,784,659,494,392],bass:[165,196,247,330],beat:145},
 {mel:[392,494,587,698,784,698,587,494],bass:[196,247,294,349],beat:135},
 {mel:[175,220,262,330,392,330,262,220],bass:[87,110,131,165],beat:125},
 {mel:[247,311,370,494,622,740,622,494],bass:[123,155,185,247],beat:120}
];
function initAudio(){if(audioCtx)return;audioCtx=new (window.AudioContext||window.webkitAudioContext)();musicGain=audioCtx.createGain();sfxGain=audioCtx.createGain();musicGain.gain.value=.045;sfxGain.gain.value=.12;musicGain.connect(audioCtx.destination);sfxGain.connect(audioCtx.destination);playMusic();}
function tone(freq,dur=.1,type='square',gain=.08,bus='sfx'){if(!audioCtx||!musicOn)return;const o=audioCtx.createOscillator(),g=audioCtx.createGain();o.type=type;o.frequency.value=freq;g.gain.setValueAtTime(gain,audioCtx.currentTime);g.gain.exponentialRampToValueAtTime(.001,audioCtx.currentTime+dur);o.connect(g);g.connect(bus==='music'?musicGain:sfxGain);o.start();o.stop(audioCtx.currentTime+dur+.02)}
function playMusic(){if(!audioCtx||!musicOn)return;clearInterval(musicTimer);let i=0;const tr=musicTracks[world%musicTracks.length];musicTimer=setInterval(()=>{if(!running||paused||shopOpen)return;const n=tr.mel[i%tr.mel.length],b=tr.bass[Math.floor(i/2)%tr.bass.length];tone(n,.18,'triangle',.62,'music');if(i%2===0)tone(b,.28,'sine',.26,'music');if(i%4===3)tone(n*2,.07,'square',.12,'music');i++},tr.beat)}
function sfx(name){
 if(name==='jump')tone(520,.09,'square',.8);
 else if(name==='coin'){tone(880,.07,'triangle',.7);setTimeout(()=>{if(audioCtx&&musicOn)tone(1320,.09,'triangle',.55)},45);}
 else if(name==='fire'){tone(150,.10,'sawtooth',.72);setTimeout(()=>{if(audioCtx&&musicOn)tone(300,.07,'square',.42)},35);}
 else if(name==='stomp')tone(110,.12,'square',.7);
 else if(name==='hit')tone(80,.15,'sawtooth',.7);
 else if(name==='star'){tone(660,.10,'triangle',.65);setTimeout(()=>{if(audioCtx&&musicOn)tone(990,.10,'triangle',.6)},55);setTimeout(()=>{if(audioCtx&&musicOn)tone(1320,.14,'sine',.55)},110);}
 else if(name==='goal'){tone(660,.12,'triangle',.75);setTimeout(()=>{if(audioCtx&&musicOn)tone(880,.14,'triangle',.7)},100);setTimeout(()=>{if(audioCtx&&musicOn)tone(1320,.22,'sine',.65)},220);}
}

